{
  "_comment": "Single source of truth for model providers and enabled models, used by the server, the console and the pipeline. Contains no secrets: endpoints, exact model IDs and API keys are read from the environment variables named here. Override the file path with FAULTSEEKER_MODELS_FILE.",
  "providers": {
    "openai": {
      "label": "OpenAI",
      "type": "openai_compatible",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "key_validation": "models_list",
      "public_endpoint": true
    },
    "ollama": {
      "label": "Ollama",
      "type": "ollama",
      "host_env": "OLLAMA_HOST"
    },
    "codex_proxy": {
      "label": "Codex proxy",
      "type": "openai_compatible",
      "base_url_env": "CODEX_PROXY_BASE_URL",
      "api_key_env": "CODEX_PROXY_API_KEY",
      "key_validation": "models_list"
    },
    "mercury": {
      "label": "Inception Mercury",
      "type": "openai_compatible",
      "base_url_env": "MERCURY_BASE_URL",
      "api_key_env": "MERCURY_API_KEY",
      "key_validation": "models_list"
    }
  },
  "models": [
    {"id": "gpt-4o-mini", "label": "GPT-4o mini", "provider": "openai", "model": "gpt-4o-mini", "params": {"temperature": "pass"}},
    {"id": "gpt-4o", "label": "GPT-4o", "provider": "openai", "model": "gpt-4o", "params": {"temperature": "pass"}},
    {"id": "gpt-4.1-mini", "label": "GPT-4.1 mini", "provider": "openai", "model": "gpt-4.1-mini", "params": {"temperature": "pass"}},
    {"id": "gpt-4.1", "label": "GPT-4.1", "provider": "openai", "model": "gpt-4.1", "params": {"temperature": "pass"}},
    {"id": "codex-proxy", "label": "Codex proxy", "provider": "codex_proxy", "model_env": "CODEX_PROXY_MODEL",
     "params": {"temperature": {"env": "CODEX_PROXY_TEMPERATURE", "type": "float", "when_unset": "omit"}}},
    {"id": "mercury", "label": "Inception Mercury", "provider": "mercury", "model_env": "MERCURY_MODEL",
     "params": {"temperature": {"env": "MERCURY_TEMPERATURE", "type": "float", "when_unset": "omit"}}}
  ]
}
