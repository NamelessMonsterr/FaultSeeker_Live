# FaultSeeker++ Environment Configuration
# Copy this file to .env and fill in your API keys
# Only ONE cloud provider is needed — pick the one you have access to

# ── Cloud LLM Providers (pick at least one) ────────────────────────────

# OpenAI (gpt-4o, gpt-4o-mini, gpt-4.1, o3-mini, ...)
OPENAI_API_KEY=

# xAI Grok (grok-3, grok-3-mini, grok-2, ...)
# Docs: https://console.x.ai/
XAI_API_KEY=

# Alibaba Qwen via DashScope (qwen-max, qwen-plus, qwen-turbo, ...)
# Docs: https://dashscope.aliyuncs.com
DASHSCOPE_API_KEY=

# Google Gemini (gemini-2.0-flash, gemini-1.5-pro, ...)
# Docs: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Anthropic Claude (claude-3-5-sonnet, claude-3-haiku, ...) [optional]
ANTHROPIC_API_KEY=

# ── Chain Explorer API Keys (for source code download) ────────────────
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_API_KEY=
BASESCAN_API_KEY=
POLYGONSCAN_API_KEY=
SNOWTRACE_API_KEY=
ZKSYNC_API_KEY=

# ── Archive + Trace RPC URLs (REQUIRED for transaction analysis) ───────
#
# IMPORTANT: debug_traceTransaction requires a TRACE-ENABLED ARCHIVE node.
# Standard public RPCs (llamarpc, cloudflare, publicnode) do NOT support it.
#
# ══════════════════════════════════════════════════════════
# ✅ OPTION 1 — Tenderly (free tier, best ETH trace support)
# ══════════════════════════════════════════════════════════
# 1. Sign up at https://tenderly.co (free, no card required)
# 2. Go to: Dashboard → Account Settings → Access Keys → Create Key
# 3. Set the key below:
TENDERLY_ACCESS_KEY=
#
# FaultSeeker++ automatically uses this for debug_traceTransaction on ETH.
# The free tier is sufficient for this project.
#
# ══════════════════════════════════════════════════════════
# ✅ OPTION 2 — Ankr (free tier, trace-enabled)
# ══════════════════════════════════════════════════════════
# 1. Sign up at https://www.ankr.com/rpc/
# 2. Generate a personal API key (free, takes 2 minutes)
ETH_RPC_URL=https://rpc.ankr.com/eth/YOUR_ANKR_KEY_HERE
BSC_RPC_URL=https://rpc.ankr.com/bsc/YOUR_ANKR_KEY_HERE
#
# ══════════════════════════════════════════════════════════
# ✅ OPTION 3 — Foundry cast run (local dev, no trace API needed)
# ══════════════════════════════════════════════════════════
# Install: winget install Foundry.Foundry
# Verify:  cast --version
# Works with any archive-state RPC (even Alchemy free tier).
#
# ⚠️  ALCHEMY FREE TIER: Does NOT support debug_traceTransaction.
#     Use Alchemy ONLY if you have Foundry installed.
#
# ══════════════════════════════════════════════════════════
ARBITRUM_RPC_URL=https://rpc.ankr.com/arbitrum/YOUR_ANKR_KEY_HERE
OPTIMISM_RPC_URL=https://rpc.ankr.com/optimism/YOUR_ANKR_KEY_HERE
BASE_RPC_URL=https://rpc.ankr.com/base/YOUR_ANKR_KEY_HERE
POLYGON_RPC_URL=https://rpc.ankr.com/polygon/YOUR_ANKR_KEY_HERE
AVALANCHE_RPC_URL=https://rpc.ankr.com/avalanche/YOUR_ANKR_KEY_HERE
ZKSYNC_RPC_URL=https://rpc.ankr.com/zksync_era/YOUR_ANKR_KEY_HERE
