# Copy to .env (git-ignored). The console server reads it automatically; real
# environment variables take precedence. Never commit real keys.

# Console access code. If unset, run.sh / run.bat generate a one-off code.
DEMO_GATE_PASSWORD=CHANGE_ME

# RPC: needs an archive/trace endpoint (debug_traceTransaction), e.g. dRPC / BlockPI.
# Free public RPCs cannot trace. Variable pattern: <CHAIN>_RPC_URL (ETH, BSC, POLYGON, ...).
ETH_RPC_URL=
BSC_RPC_URL=

# Model keys (only the provider you select in the UI is needed).
GOOGLE_API_KEY=
OPENAI_API_KEY=
INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
ITERA_API_KEY=
CODEX_PROXY_BASE_URL=
OPENAI_DIRECT_BASE_URL=
OPENAI_DIRECT_API_KEY=

FAULTSEEKER_RUNS_DIR=./console/app/runs
FAULTSEEKER_STAGE2_WORKERS=1
FAULTSEEKER_MODEL_TIME_BUDGET_SECS=7200
INCEPTION_REASONING_EFFORT=instant
