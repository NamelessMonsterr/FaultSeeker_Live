# FaultSeeker++ configuration. Copy to .env (never commit .env) or set these in your host's dashboard.
# This file contains variable NAMES and placeholders only. Never put real keys in it.

# --- Access protection (required before hosting publicly) -----------------------------------------------
# Choose your own code, at least 12 characters. There is no default. Leave empty only for private local use.
FAULTSEEKER_ACCESS_CODE=
# Session lifetime in hours (default 12) and login rate limit (failures per address per window).
# FAULTSEEKER_SESSION_HOURS=12
# FAULTSEEKER_LOGIN_MAX_FAILURES=5
# FAULTSEEKER_LOGIN_WINDOW_SECONDS=900
# Set to 1 when the server is reachable by others (Render and the Docker image set this for you).
# FAULTSEEKER_PUBLIC=1
# Explicit acceptance of the risk of a public server that holds a model key without an access code. Do not set.
# FAULTSEEKER_ALLOW_UNSAFE_PUBLIC=

# --- Models: config/models.json declares providers and models; these variables fill in the details --------
# Which registry models are offered (comma-separated ids). Empty = every model that is fully configured.
# FAULTSEEKER_ENABLED_MODELS=gpt-4o-mini,codex-proxy,mercury
# FAULTSEEKER_DEFAULT_MODEL=
# Override the registry file (default config/models.json).
# FAULTSEEKER_MODELS_FILE=

# Direct OpenAI. Leave the key empty to make every user bring their own key.
OPENAI_API_KEY=

# Codex proxy (OpenAI-compatible). The base URL and the exact model ID come from your proxy, not from this repository.
CODEX_PROXY_BASE_URL=
CODEX_PROXY_MODEL=
CODEX_PROXY_API_KEY=
# Optional: a fixed temperature for this model. Unset means no temperature is sent.
# CODEX_PROXY_TEMPERATURE=

# Inception Mercury (OpenAI-compatible). Base URL and exact model ID come from your account.
MERCURY_BASE_URL=
MERCURY_MODEL=
MERCURY_API_KEY=
# MERCURY_TEMPERATURE=

# Local Ollama: comma-separated model names to offer (ids become ollama:<name>), and the server address.
# FAULTSEEKER_OLLAMA_MODELS=
# OLLAMA_HOST=

# --- Blockchain access --------------------------------------------------------------------------------
# Needed to download verified source on BSC, Base, Optimism and Avalanche (Etherscan paid tier).
ETHERSCAN_API_KEY=
# Optional proxy for explorer page fetches if the explorer blocks the server.
# FAULTSEEKER_HTTP_PROXY=
# Set to 0 to let cast do online signature lookups (default 1 = offline, for reproducible traces).
# FAULTSEEKER_CAST_OFFLINE=1
